generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model AccommodationRating {
  id              String        @id @default(cuid())
  rating          Float
  review          String?
  userId          String
  accommodationId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  @@unique([userId, accommodationId])
  @@index([accommodationId])
  @@index([userId])
}

model CareerOutcome {
  id                  String                   @id @default(cuid())
  type                CareerOutcomeType
  universityId        String?
  salaryChartData     SalaryChartData[]
  employmentRateMeter EmploymentRateMeterData?
  courseTimelineData  CourseTimelineData[]
  university          University?              @relation(fields: [universityId], references: [id])
}

model SalaryChartData {
  id              String        @id @default(cuid())
  sector          String
  min             Float
  max             Float
  color           String
  percentage      Float
  careerOutcomeId String
  careerOutcome   CareerOutcome @relation(fields: [careerOutcomeId], references: [id])
}

model EmploymentRateMeterData {
  id              String        @id @default(cuid())
  targetRate      Float
  size            Float
  careerOutcomeId String        @unique
  careerOutcome   CareerOutcome @relation(fields: [careerOutcomeId], references: [id])
}

model CourseTimelineData {
  id              String        @id @default(cuid())
  course          String
  careerOutcomeId String
  careerOutcome   CareerOutcome @relation(fields: [careerOutcomeId], references: [id])
}

model Faq {
  id           String     @id @default(cuid())
  question     String
  answer       String
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
}

model University {
  id               String                   @id @default(cuid())
  name             String
  description      String
  location         String
  country          String
  established      DateTime
  website          String
  logoUrl          String?
  imageUrls        String[]
  facilities       String[]
  studentReviews   Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  banner           String
  slug             String?                  @unique
  youtubeLink      String?
  descriptionTitle String?
  careerOutcomes   CareerOutcome[]
  faqs             Faq[]
  applications     UniversityApplications[]
  loans            Loan[]
  users            User[]
  courses          Course[]
}

model Course {
  id           String                   @id @default(cuid())
  name         String
  description  String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  degreeType   String?
  duration     String?
  fees         String?
  ieltsScore   String?
  intake       String[]
  ranking      String?
  universityId String
  websiteLink  String?
  image        String?
  applications UniversityApplications[]
  favByUsers   FavCourse[]
  university   University               @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
}

model UniversityApplications {
  id              String            @id @default(cuid())
  userId          String
  universityId    String
  courseId        String
  status          ApplicationStatus @default(PENDING)
  appliedAt       DateTime          @default(now())
  loanRequired    Boolean           @default(false)
  documents       String[]
  additionalNotes String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id])
  university      University        @relation(fields: [universityId], references: [id])
  course          Course            @relation(fields: [courseId], references: [id])

  @@index([userId])
  @@index([universityId])
  @@index([courseId])
}

model Accommodation {
  id            String                @id @default(cuid())
  title         String
  description   String
  type          AccommodationType
  address       String
  city          String
  country       String
  includeBills  Boolean?
  deposit       Float?
  furnishing    FurnishingType?
  bathrooms     Int
  bedrooms      Int
  size          Float?
  amenities     String[]
  rules         String[]
  images        String[]
  availableFrom DateTime
  minTerm       Int
  maxTerm       Int?
  isAvailable   Boolean               @default(true)
  landlordId    String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  banner        String
  averageRating Float?
  totalRatings  Int                   @default(0)
  landlord      User                  @relation("LandlordAccommodations", fields: [landlordId], references: [id])
  reviews       AccommodationReview[]
  ratings       AccommodationRating[]
  likedBy       LikedAccommodations[]
  pricingPlans  PricingPlan[]

  @@index([landlordId])
}

model PricingPlan {
  id              String        @id @default(cuid())
  accommodationId String
  price           Float
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  type            String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id])

  @@index([accommodationId])
}

model AccommodationApplication {
  id                String            @id @default(cuid())
  userId            String
  accommodationId   String
  interestedFrom    DateTime
  interestedTill    DateTime
  numberOfOccupants Int
  additionalNotes   String?
  status            ApplicationStatus @default(PENDING)
  createdAt         DateTime          @default(now())
}

model AccommodationReview {
  id              String        @id @default(cuid())
  rating          Float
  review          String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  accommodationId String
  userId          String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@index([accommodationId])
  @@index([userId])
}

model Message {
  id          String   @id @default(cuid())
  content     String
  attachments String[]
  isRead      Boolean  @default(false)
  senderId    String
  receiverId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Following", fields: [followerId], references: [id])
  following   User     @relation("Followers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Loan {
  id                  String            @id @default(cuid())
  title               String
  description         String
  amount              Float
  interestRate        Float
  duration            Int
  eligibilityCriteria String[]
  documents           String[]
  deadline            DateTime?
  maxApplications     Int?
  isActive            Boolean           @default(true)
  universityId        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  university          University?       @relation(fields: [universityId], references: [id])
  applications        LoanApplication[]

  @@index([universityId])
}

model LoanApplication {
  id            String            @id @default(cuid())
  status        ApplicationStatus @default(PENDING)
  documents     String[]
  academicInfo  Json
  financialInfo Json
  notes         String?
  loanId        String
  userId        String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  loan          Loan              @relation(fields: [loanId], references: [id])
  user          User              @relation(fields: [userId], references: [id])

  @@index([loanId])
  @@index([userId])
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  status    VoteType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId])
  @@index([userId])
}

model Group {
  id             String        @id @default(cuid())
  name           String        @unique
  slug           String        @unique
  banner         String?
  logo           String?
  description    String
  privacy        GroupPrivacy  @default(PUBLIC)
  followersCount Int           @default(0)
  postsCount     Int           @default(0)
  createdById    String
  isPinned       Boolean       @default(false)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdBy      User          @relation("GroupCreator", fields: [createdById], references: [id])
  events         Event[]
  articles       Article[]
  forums         Forum[]
  members        GroupMember[]
  moderators     User[]        @relation("GroupAdmins")

  @@index([createdById])
  @@index([privacy])
  @@index([isActive])
}

model GroupMember {
  id       String          @id @default(cuid())
  groupId  String
  userId   String
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now())
  group    Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model Event {
  id               String              @id @default(cuid())
  title            String
  description      String
  date             DateTime
  image            String?
  location         String
  totalSlots       Int
  contactById      String
  address          String?
  createdAt        DateTime            @default(now())
  currency         String?
  endTime          DateTime?
  eventType        EventType           @default(ONLINE)
  groupId          String
  registeredSlots  Int                 @default(0)
  registrationType RegistrationType    @default(FREE)
  startTime        DateTime
  status           EventStatus         @default(UPCOMING)
  ticketPrice      Float?
  updatedAt        DateTime            @updatedAt
  virtualLink      String?
  waitlistSlots    Int?
  slug             String
  contactBy        User                @relation("EventHost", fields: [contactById], references: [id])
  group            Group               @relation(fields: [groupId], references: [id])
  registrations    EventRegistration[]

  @@index([contactById])
  @@index([groupId])
  @@index([date])
  @@index([status])
}

model EventRegistration {
  id             String                  @id @default(cuid())
  eventId        String
  userId         String
  status         EventRegistrationStatus @default(CONFIRMED)
  additionalInfo Json?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  event          Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model Forum {
  id           String       @id @default(cuid())
  description  String?
  groupId      String
  type         ForumType    @default(DISCUSSION)
  privacy      ForumPrivacy @default(GROUP)
  topicCount   Int          @default(0)
  isLocked     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  attachments  String[]
  creatorId    String
  lastReplyAt  DateTime?
  replyCount   Int          @default(0)
  tags         String[]
  title        String
  viewCount    Int          @default(0)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator      User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  topics       ForumTopic[]
  forumReplies ForumReply[]

  @@index([groupId])
  @@index([type])
  @@index([privacy])
}

model ForumTopic {
  id          String       @id @default(cuid())
  title       String
  content     String
  forumId     String
  creatorId   String
  type        TopicType    @default(DISCUSSION)
  isPinned    Boolean      @default(false)
  isClosed    Boolean      @default(false)
  viewCount   Int          @default(0)
  replyCount  Int          @default(0)
  lastReplyAt DateTime?
  status      TopicStatus  @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  forum       Forum        @relation(fields: [forumId], references: [id], onDelete: Cascade)
  creator     User         @relation("UserForumTopics", fields: [creatorId], references: [id], onDelete: Cascade)
  posts       ForumPost[]
  replies     ForumReply[]

  @@index([forumId])
  @@index([creatorId])
  @@index([type])
  @@index([status])
}

model ForumReply {
  id            String               @id @default(cuid())
  forumId       String
  topicId       String
  userId        String
  content       String
  attachments   String[]
  likes         Int                  @default(0)
  parentReplyId String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  forum         Forum                @relation(fields: [forumId], references: [id], onDelete: Cascade)
  topic         ForumTopic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions     ForumReplyReaction[]
  parentReply   ForumReply?          @relation("ReplyThreads", fields: [parentReplyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  childReplies  ForumReply[]         @relation("ReplyThreads")

  @@index([forumId])
  @@index([topicId])
  @@index([userId])
  @@index([parentReplyId])
}

model ForumPost {
  id           String              @id @default(cuid())
  content      String
  topicId      String
  creatorId    String
  likes        Int                 @default(0)
  parentPostId String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  topic        ForumTopic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  creator      User                @relation("ForumPostCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  reactions    ForumPostReaction[]
  parentPost   ForumPost?          @relation("PostReplies", fields: [parentPostId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replies      ForumPost[]         @relation("PostReplies")

  @@index([topicId])
  @@index([creatorId])
  @@index([parentPostId])
}

model ForumReplyReaction {
  id           String       @id @default(cuid())
  forumReplyId String
  userId       String
  type         ReactionType
  forumReply   ForumReply   @relation(fields: [forumReplyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user         User         @relation("UserReplyReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([forumReplyId, userId, type])
  @@index([forumReplyId])
  @@index([userId])
}

model ForumPostReaction {
  id          String       @id @default(cuid())
  userId      String
  type        ReactionType
  forumPostId String
  forumPost   ForumPost    @relation(fields: [forumPostId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user        User         @relation("UserPostReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([forumPostId, userId, type])
  @@index([forumPostId])
  @@index([userId])
}

model Article {
  id          String        @id @default(cuid())
  title       String        @db.VarChar(255)
  content     String
  tags        String[]      @db.VarChar(50)
  bannerImg   String?       @db.VarChar(500)
  createdAt   DateTime      @default(now())
  creatorId   String
  description String?       @db.VarChar(500)
  downVotes   Int           @default(0)
  images      String[]      @db.VarChar(500)
  status      ArticleStatus @default(DRAFT)
  type        ArticleType   @default(COMMUNITY)
  upVotes     Int           @default(0)
  updatedAt   DateTime      @updatedAt
  views       Int           @default(0)
  groupId     String?
  creator     User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  group       Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  votes       Vote[]

  @@index([creatorId])
  @@index([groupId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  expires      DateTime
  createdAt    DateTime  @default(now())
  ipAddress    String?
  lastActivity DateTime?
  refreshToken String?   @unique
  userAgent    String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([refreshToken])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FavCourse {
  id             String   @id @default(cuid())
  userId         String
  courseId       String
  createdAt      DateTime @default(now())
  courseName     String?
  universityId   String?
  universityName String?
  user           User     @relation(fields: [userId], references: [id])
  course         Course   @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model User {
  id                   String                   @id @default(cuid())
  username             String                   @unique
  email                String                   @unique
  password             String?
  phoneNumber          String?
  name                 String
  bio                  String?
  avatarUrl            String?
  role                 UserRole                 @default(STUDENT)
  resetPasswordToken   String?
  resetPasswordExpiry  DateTime?
  isVerified           Boolean                  @default(false)
  isPhoneVerified      Boolean                  @default(false)
  isEmailVerified      Boolean                  @default(false)
  otpRetryCount        Int                      @default(0)
  otpLastSentAt        DateTime?
  otpBlockedUntil      DateTime?
  followersCount       Int                      @default(0)
  followingCount       Int                      @default(0)
  universityId         String?
  department           String?
  program              String?
  graduationYear       Int?
  isLandlordVerified   Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  isLocked             Boolean                  @default(false)
  lastLoginAt          DateTime?
  lockUntil            DateTime?
  loginAttempts        Int                      @default(0)
  lastPasswordChangeAt DateTime?
  countryCode          String?                  @default("+91")
  googleId             String?                  @unique
  lastLogin            DateTime?
  banner               String?
  header               String?                  @default("default_header")
  emailVerified        DateTime?
  googleAccessToken    String?
  googleRefreshToken   String?
  googleTokenExpiry    DateTime?
  image                String?
  favCourses           FavCourse[]
  quizAnswers          QuizAnswer[]
  createdForums        Forum[]
  createdForumTopics   ForumTopic[]             @relation("UserForumTopics")
  forumReplies         ForumReply[]
  forumPosts           ForumPost[]              @relation("ForumPostCreator")
  forumReplyReactions  ForumReplyReaction[]     @relation("UserReplyReactions")
  forumPostReactions   ForumPostReaction[]      @relation("UserPostReactions")
  university           University?              @relation(fields: [universityId], references: [id])
  loanApplications     LoanApplication[]
  accommodationRatings AccommodationRating[]
  applications         UniversityApplications[]
  tokens               Token[]
  accommodations       Accommodation[]          @relation("LandlordAccommodations")
  accounts             Account[]
  sessions             Session[]
  otps                 OTP[]
  notifications        Notification[]
  followers            Follow[]                 @relation("Following")
  following            Follow[]                 @relation("Followers")
  sentMessages         Message[]                @relation("SentMessages")
  receivedMessages     Message[]                @relation("ReceivedMessages")
  createdGroups        Group[]                  @relation("GroupCreator")
  adminOf              Group[]                  @relation("GroupAdmins")
  groupMemberships     GroupMember[]
  hostedEvents         Event[]                  @relation("EventHost")
  articles             Article[]
  accommodationReviews AccommodationReview[]
  likedAccommodations  LikedAccommodations[]

  @@index([email])
  @@index([username])
  @@index([universityId])
  @@index([isVerified])
  @@index([countryCode])
  @@index([department])
}

model QuizAnswer {
  id         Int    @id @default(autoincrement())
  userId     String
  questionId Int
  answer     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LikedAccommodations {
  id              String        @id @default(cuid())
  userId          String
  accommodationId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  @@unique([userId, accommodationId])
  @@index([userId])
  @@index([accommodationId])
}

model Token {
  id        String    @id @default(cuid())
  token     String    @unique
  type      TokenType
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model OTP {
  id          String     @id @default(cuid())
  userId      String
  otpCode     String
  type        OTPType
  purpose     OTPPurpose
  verified    Boolean    @default(false)
  attempts    Int        @default(0)
  expiresAt   DateTime
  verifiedAt  DateTime?
  invalidated Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([otpCode])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Blog {
  id            String         @id @default(uuid()) @db.Uuid
  title         String
  slug          String         @unique
  summary       String
  coverImage    String?
  published     Boolean        @default(false)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @db.Timestamptz(6)
  contentBlocks ContentBlock[]
}

model ContentBlock {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  content   String
  order     Int
  blogId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  details    String
  createdAt  DateTime @default(now())
}

model GroupAdmins {
  A String
  B String

  @@id([A, B], map: "_GroupAdmins_AB_pkey")
  @@index([B], map: "_GroupAdmins_B_index")
  @@map("_GroupAdmins")
}

enum CareerOutcomeType {
  SALARY_CHART
  EMPLOYMENT_RATE_METER
  COURSE_TIMELINE
}

enum TokenType {
  REFRESH
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum UniversityType {
  PUBLIC
  PRIVATE
}

enum UserRole {
  STUDENT
  LANDLORD
  ADMIN
}

enum AccommodationType {
  PRIVATE_ROOM
  SHARED_ROOM
  STUDIO
  APARTMENT
  HOUSE
}

enum FurnishingType {
  FURNISHED
  UNFURNISHED
  PARTIAL
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  UNDER_REVIEW
}

enum OTPType {
  EMAIL
  PHONE
}

enum OTPPurpose {
  SIGNUP_VERIFICATION
  LOGIN_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
  PHONE_CHANGE
  PROFILE_UPDATE
}

enum NotificationType {
  OTP_SENT
  OTP_VERIFIED
  OTP_EXPIRED
  OTP_INVALID
  ACCOUNT_VERIFIED
  LOGIN_ALERT
  PASSWORD_CHANGED
  EMAIL_CHANGED
  PHONE_CHANGED
  PROFILE_UPDATED
  SECURITY_ALERT
  LENDERS
}

enum ArticleType {
